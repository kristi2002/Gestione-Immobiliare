# Gestionale Immobiliare — Apache security rules

# Upload limits (videos up to ~25 MB). Applies on mod_php hosts without an image rebuild.
<IfModule php_module>
    php_value upload_max_filesize 25M
    php_value post_max_size 26M
    php_value max_execution_time 120
    php_value max_input_time 120
</IfModule>

# ── Legacy PHP admin is the default frontend at "/" ──────────────────────────
# The React SPA cutover was abandoned: index.php serves at "/" again. The React
# build (index.html + _app-assets/) is no longer copied into the web root by the
# Dockerfile, so there is nothing to shadow index.php. DirectoryIndex is pinned
# to index.php so a bare "/" request always renders the PHP dashboard shell.
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── Public website (sito vetrina "Immobiliare Orlandi") ──────────────────
    # The static marketing site lives in /web-orlandi/ and is already reachable
    # at  https://<questo-dominio>/web-orlandi/ .
    # To serve it on its OWN (sub)domain instead: point that domain's DNS at this
    # server, add the domain to this service in Coolify, then replace
    # PUBLIC-DOMAIN-HERE below with it (e.g. www.immobiliareorlandi.it) and
    # UNCOMMENT the three lines. The gestionale on its own domain is unaffected.
    #   RewriteCond %{HTTP_HOST} ^(www\.)?PUBLIC-DOMAIN-HERE$ [NC]
    #   RewriteCond %{REQUEST_URI} !^/web-orlandi/
    #   RewriteRule ^(.*)$ /web-orlandi/$1 [L]

    # Block web access to sensitive directories
    RewriteRule ^config/ - [F,L]
    RewriteRule ^database/ - [F,L]
    RewriteRule ^cron/ - [F,L]
    RewriteRule ^backups/ - [F,L]
    # scripts/ was missing from this list. It holds maintenance CLI tools that
    # print what they operate on: scripts/db_check.php answers an unauthenticated
    # GET with the DB host, the DB name, row counts and every admin username and
    # role. Blocked here, and each script now refuses to run outside the CLI.
    RewriteRule ^scripts/ - [F,L]
    RewriteRule ^tests/ - [F,L]
    RewriteRule ^vendor/ - [F,L]
    # Session jars, dumps and dependency manifests that have no business being
    # fetchable if one ever lands in the image.
    RewriteRule ^(cookies\.txt|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml)$ - [F,L]

    # Defense-in-depth: deny ALL direct access to the uploaded-documents tree
    # (ID scans, contracts, generated PDFs/invoices, private attachments). These
    # are personal data and must only ever be reached via the auth-checked
    # api/download_document.php / api/download_pdf.php / api/media.php streamers.
    # This duplicates uploads/documents/.htaccess so protection survives even if
    # that nested file is lost during a deploy/rsync.
    RewriteRule ^uploads/documents/ - [F,L]

    # And never serve office/archive document types from anywhere under uploads/
    # (belt-and-suspenders for uploads/properties, which is otherwise public images).
    RewriteRule ^uploads/.*\.(pdf|docx?|xlsx?|pptx?|txt|csv|zip|rar|7z|odt|ods|odp|rtf)$ - [F,L]
</IfModule>

# ── Compression ──────────────────────────────────────────────────────────────
# gzip text responses (HTML, CSS, JS, JSON, SVG). Cuts transfer size ~70%.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
        application/javascript application/x-javascript application/json \
        application/xml image/svg+xml application/rss+xml
</IfModule>

# ── Client caching ───────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    # "immutable" is only true for a URL that carries a version. index.php and the
    # view loader append ?v=<filemtime> / ?t=<token> to the files they request —
    # but an ES module's own `import` statements do not, so every sub-module under
    # assets/js/<page>/ and assets/js/lib/ was being fetched bare and then pinned
    # in the browser cache for a year. A returning user would never pick up a fix
    # to one. Version-less asset URLs revalidate instead.
    <IfModule mod_setenvif.c>
        SetEnvIf Query_String "(^|&)(v|t)=" GI_VERSIONED_ASSET=1
    </IfModule>
    <FilesMatch "\.(css|js|mjs)$">
        Header set Cache-Control "public, max-age=31536000, immutable" env=GI_VERSIONED_ASSET
        Header set Cache-Control "public, max-age=300, must-revalidate" env=!GI_VERSIONED_ASSET
    </FilesMatch>
    # Images and fonts — cache a week (property photos use stable filenames).
    <FilesMatch "\.(png|jpe?g|gif|webp|svg|ico|woff2?|ttf|eot)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    # Dynamic PHP (SPA shell, API JSON, view partials, and the personal-data file
    # streamers) — always revalidate and never let a proxy store the response.
    <FilesMatch "\.php$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>

    # ── Baseline security headers ────────────────────────────────────────────
    # The app renders owner/tenant personal data and ID documents; none of it
    # should be framable, sniffable, or leaked into a third-party Referer.
    # (A Content-Security-Policy is NOT set here: the pages still carry inline
    #  <script> and inline style attributes, so a policy strict enough to be
    #  worth having would break them. Tracked as remaining work.)
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=(self)"
</IfModule>

<Files ".env">
    Require all denied
</Files>

<Files ".setup_complete">
    Require all denied
</Files>
